# Jamendo API client id (free): create an app at https://devportal.jamendo.com/
# Copy this file to .env and paste the id. Never commit .env — the id stays on the server.
JAMENDO_CLIENT_ID=

# ---- Firebase accounts (optional) ----
# With both values below the server runs in "firebase" mode: listeners sign in (Email/Password or
# Google) and each user's likes, playlists, history and player state are stored in Realtime
# Database under users/{uid}. Without them the server runs in "local" mode (no sign-in, one
# shared user, state in server/data-store/user-state.json) and logs a warning once.
#
# Realtime Database URL (Firebase Console → Realtime Database → Data tab, top of the tree), e.g.
# https://your-project-default-rtdb.europe-west1.firebasedatabase.app
FIREBASE_DATABASE_URL=
# Service-account key (Project settings → Service accounts → Generate new private key).
# Relative paths are resolved from the server/ directory. The file is gitignored
# (*service-account*.json) and is never sent to the browser.
FIREBASE_SERVICE_ACCOUNT_PATH=firebase-service-account.json
# Alternative for containers / PaaS: the whole key as raw JSON or base64 (never commit it).
# FIREBASE_SERVICE_ACCOUNT_JSON=

# ---- Firebase Emulator Suite (local testing, no service account needed) ----
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIREBASE_DATABASE_EMULATOR_HOST=127.0.0.1:9000
# FIREBASE_PROJECT_ID=demo-muify
# (with emulators, set FIREBASE_DATABASE_URL=http://127.0.0.1:9000?ns=demo-muify)

# Optional: where local-mode user state is stored.
# Default: server/data-store/ (gitignored). Relative paths resolve from the working directory.
# MUIFY_DATA_DIR=

# ---- Production (npm start / Docker) — see README → Deploy ----
# PORT=4000                 # one port for the API + the built client (Docker image: 8080)
# HOST=                     # bind address (default: all interfaces)
# NODE_ENV=production       # `npm start` sets it; serves client/dist with SPA fallback
# SERVE_CLIENT=true         # serve client/dist even without NODE_ENV=production
# MUIFY_CLIENT_DIR=         # custom path of the built client (default: ../client/dist)
# TRUST_PROXY=1             # behind a reverse proxy / load balancer: hops to trust (or "loopback", CIDRs)
# FIREBASE_AUTH_DOMAIN=     # custom Firebase auth domain, added to the CSP (default *.firebaseapp.com / *.web.app)
# CSP_IMG_SRC=              # extra image origins for the CSP (space separated)
# CSP_CONNECT_SRC=          # extra connect-src origins (e.g. the Auth emulator in a staging setup)
# CSP_UPGRADE_INSECURE=true # only when served over HTTPS
# HSTS=true                 # only when served over HTTPS
# JSON_BODY_LIMIT=100kb
# RATE_LIMIT_WRITES=300     # POST/PUT/PATCH/DELETE per client IP per minute (0 = off)
# RATE_LIMIT_ACCOUNT=20     # account deletion / sign-out everywhere / export per 10 minutes
# RATE_LIMIT_SEARCH=60      # /api/search per minute
