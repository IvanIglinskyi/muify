# Firebase web config for sign-in (Firebase Console → Project settings → General → Your apps →
# Web app → "SDK setup and configuration" → Config). Copy this file to client/.env.local
# (gitignored) and fill in the values. These are public identifiers, not secrets — the browser
# uses them for Firebase Authentication only; all data goes through the MuiFy API.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_APP_ID=
# Optional (not used by MuiFy, but harmless to keep from the console snippet)
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Local development against the Firebase Emulator Suite (npx firebase-tools emulators:start).
# VITE_USE_FIREBASE_EMULATORS=true
# VITE_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099
